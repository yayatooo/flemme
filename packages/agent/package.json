{
	"name": "@flemme/agent",
	"module": "index.ts",
	"exports": {
		".": "./index.ts",
		"./cooking-recommendation-output": "./src/schemas/cooking-recommendation-output.ts",
		"./pre-cooking-output": "./src/schemas/pre-cooking-output.ts",
		"./active-cooking-input": "./src/schemas/active-cooking-input.ts",
		"./active-cooking-output": "./src/schemas/active-cooking-output.ts",
		"./completion-output": "./src/schemas/completion-output.ts"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"eval:active-cooking": "bun --env-file=../../.env run evals/active-cooking.eval.ts",
		"eval:all": "bun --env-file=../../.env run evals/run-all.ts",
		"eval:completion": "bun --env-file=../../.env run evals/completion.eval.ts",
		"eval:judge": "bun --env-file=../../.env run evals/judge.eval.ts",
		"eval:pre-cooking": "bun --env-file=../../.env run evals/pre-cooking.eval.ts",
		"eval:recommendation": "bun --env-file=../../.env run evals/recommendation.eval.ts",
		"eval:smoke": "bun --env-file=../../.env run evals/recommendation.eval.ts --smoke",
		"eval:test": "bun test evals",
		"probe:structured-output": "bun --env-file=../../.env run structured-output-probe.ts",
		"runner": "bun --env-file=../../.env run runners/recommendation.ts",
		"runner:active-cooking": "bun --env-file=../../.env run runners/active-cooking.ts",
		"runner:completion": "bun --env-file=../../.env run runners/completion.ts",
		"runner:pre-cooking": "bun --env-file=../../.env run runners/pre-cooking.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "^1.4.1"
	},
	"peerDependencies": {},
	"dependencies": {
		"@anvia/core": "1.5.0",
		"@anvia/openai": "1.1.5",
		"@valibot/to-json-schema": "1.8.0",
		"zod": "4.6.5"
	}
}
