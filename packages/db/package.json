{
	"name": "@flemme/db",
	"type": "module",
	"private": true,
	"scripts": {
		"db:check": "drizzle-kit check --config=drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "bun --env-file=../../.env run src/migrate.ts",
		"db:seed": "bun --env-file=../../.env run src/seed.ts",
		"db:validate-lifecycle": "bun --env-file=../../.env run src/testing/validate-cooking-lifecycle.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@flemme/ingredients": "workspace:*",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10"
	},
	"peerDependencies": {},
	"dependencies": {
		"@flemme/agent": "workspace:*",
		"@flemme/nutrition": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	}
}
