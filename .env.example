# Public web build configuration (never place secrets in VITE_* values).
VITE_API_URL=/api
VITE_GOOGLE_AUTH_ENABLED=false

# Host-side Compose configuration.
WEB_HOST_PORT=8080
API_HOST_PORT=3000
FLEMME_IMAGE_TAG=local

# API runtime configuration. Production Compose overrides API_HOST and PORT.
API_HOST=127.0.0.1
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000

# OpenRouter (required only for user-triggered AI cooking features).
OPENROUTER_API_KEY=
# Optional; defaults to openai/gpt-5.6-luna.
OPENROUTER_MODEL=

# Local PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=
# DATABASE_URL must use the same POSTGRES_USER, POSTGRES_PASSWORD, and
# POSTGRES_DB values and the Compose hostname `postgres` in production.

# Auth foundation: generate a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development seed only. Both values are required by db:seed; never run it in
# production.
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# Recommendation runtime observability is off unless explicitly enabled.
# The local canary command owns its ephemeral loopback relay URL.
FLEMME_OBSERVABILITY_ENABLED=false
FLEMME_OBSERVABILITY_SAMPLE_RATE=0
