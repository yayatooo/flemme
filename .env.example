# Agent provider (required only for local AI runners)
MUX_API_KEY=
BASE_URL=

# Local PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# Auth foundation: generate your own secret (at least 32 characters).
# Email/password and Google are active; all Auth variables below are required.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Public browser configuration. This is the only Auth-related VITE_* value.
VITE_API_URL=http://localhost:3000
# Google Cloud OAuth client type: Web application. Server-only credentials.
# Authorized redirect URI must match exactly:
# http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommendation runtime observability is off unless explicitly enabled.
# The local canary command owns its ephemeral loopback relay URL.
FLEMME_OBSERVABILITY_ENABLED=false
FLEMME_OBSERVABILITY_SAMPLE_RATE=0
