{
	"name": "@flemme/lens-eval-smoke",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.2.20",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"canary:runtime": "node --env-file=../../infra/lens-local/.env.flemme-agent src/run-runtime-canary.ts",
		"smoke": "node --env-file=../../infra/lens-local/.env.flemme-agent src/run-smoke.ts",
