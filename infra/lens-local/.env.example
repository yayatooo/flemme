# Anvia Lens release v0.13.0. Keep this pinned.
LENS_VERSION=0.13.0

# Browser-facing loopback origin.
PUBLIC_APP_URL=http://127.0.0.1:18080
WEB_ORIGIN=http://127.0.0.1:18080

# Generate independent values; never reuse application or database credentials.
POSTGRES_PASSWORD=<generate-a-random-64-character-hex-value>
CLICKHOUSE_PASSWORD=<generate-a-different-random-64-character-hex-value>
REDIS_PASSWORD=<generate-a-different-random-64-character-hex-value>
BETTER_AUTH_SECRET=<generate-a-different-random-64-character-hex-value>
INGESTION_KEY_PEPPER=<generate-a-different-random-64-character-hex-value>
